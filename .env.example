ANTHROPIC_API_KEY=

AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appEgMC4EDBhKZp7Z
AIRTABLE_TABLE_CLIENTES=tbl8ULWgWwSoVt3xZ
AIRTABLE_TABLE_CLIENTES_AGENDA=tblLU6jki8lH4EnQ9
AIRTABLE_TABLE_TIPOS_CITA=tblOJrUhlTsULN5zA
AIRTABLE_TABLE_RESERVAS=tbl92F2uco89CSg6A
# Tabla tecnica de errores ya usada por el nodo LogError de n8n (NO es
# "LogAgente": esa es el log de conversacion paciente/asistente para el informe
# semanal, tiene un shape distinto y no debe recibir fallos tecnicos).
AIRTABLE_TABLE_ERRORES=tblmrUO0PgVMD4ZBW

# JSON completo de la cuenta de servicio de Google, en una sola linea (o base64).
GOOGLE_SERVICE_ACCOUNT_JSON=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Mismo bot/chat que TelegramNotificarLead en workflow-molaria-leads.json.
# El chat_id ya se conoce (7977484176); el token del bot hay que sacarlo de la
# credencial "Telegram account" en n8n (id 8OExChLKq941pguG) o de BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=7977484176
