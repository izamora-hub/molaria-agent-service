{
  "name": "molaria-agent-service",
  "version": "0.1.0",
  "description": "Nucleo agentico de MolarIA (loop de Claude + herramientas) extraido de n8n, invocado por HTTP.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "alta:token": "node --env-file-if-exists=.env --import tsx scripts/generar_token_alta.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "express": "^4.21.1",
    "googleapis": "^144.0.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.0",
    "redis": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
